  <bpmn:process id="Combined_ParallelStudentProgramFSM" name="Combined - Parallel Student × Program FSM" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Combined_ParallelStudentProgramFSM">
      <bpmn:lane id="Lane_admissions" name="Admissions Office">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_student_lane" name="Student (University Standing)">
        <bpmn:flowNodeRef>S1_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4_0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_program_lane" name="Program Office (Academic Standing)">
        <bpmn:flowNodeRef>P1_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_validation" name="Records / Validation System">
        <bpmn:flowNodeRef>VALID</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Admitted from A7.x"/>
    <bpmn:task id="S1_0" name="S1.0 - Without Enrollment"/>
    <bpmn:task id="S2_0" name="S2.0 - Active"/>
    <bpmn:task id="S2_2" name="S2.2 - Under LOA"/>
    <bpmn:task id="S3_1" name="S3.1 - AWOL"/>
    <bpmn:endEvent id="S4_1" name="S4.1 - Exited"/>
    <bpmn:endEvent id="S4_0" name="S4.0 - Graduated"/>
