  <bpmn:collaboration id="Collaboration_Applicant_Part2b_AdmissionResults">
    <bpmn:participant id="Participant_Applicant_Part2b_AdmissionResults" name="A — Part 2B: Admission Results" processRef="Applicant_Part2b_AdmissionResults"/>
  </bpmn:collaboration>
  <bpmn:process id="Applicant_Part2b_AdmissionResults" name="A — Part 2B: Admission Results" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Applicant_Part2b_AdmissionResults">
      <bpmn:lane id="Lane_applicant" name="Applicant">
        <bpmn:flowNodeRef>End_Accept</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_oas" name="OAS / Admissions Office">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A5_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A5_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A5_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A5_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A5_5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="After evaluation [OAS]">
