        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#CA8A04"/>
      </bpmn:extensionElements>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="A5_0" name="A5.0 — Offered [OAS]">
