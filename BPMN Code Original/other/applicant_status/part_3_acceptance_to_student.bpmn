<?xml version="1.0" ?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_Applicant_Part3_AcceptanceToStudent" targetNamespace="http://dlsu.edu.ph/student-journey">
  <bpmn:collaboration id="Collaboration_Applicant_Part3_AcceptanceToStudent">
    <bpmn:participant id="Participant_Applicant_Part3_AcceptanceToStudent" name="A — Part 3: Acceptance to Student" processRef="Applicant_Part3_AcceptanceToStudent"/>
  </bpmn:collaboration>
  <bpmn:process id="Applicant_Part3_AcceptanceToStudent" name="A — Part 3: Acceptance to Student" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Applicant_Part3_AcceptanceToStudent">
      <bpmn:lane id="Lane_applicant" name="Applicant">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_oas" name="OAS / Admissions Office">
        <bpmn:flowNodeRef>A6_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A7_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A7_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_registrar" name="University Records (Registrar)">
        <bpmn:flowNodeRef>S1_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Student</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Admission offer [Applicant]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#DCFCE7</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#16A34A</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#DCFCE7"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#16A34A"/>
      </bpmn:extensionElements>
    </bpmn:startEvent>
    <bpmn:serviceTask id="A6_0" name="A6.0 — Reserved [Admissions]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#D1FAE5</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#059669</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#D1FAE5"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#059669"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Req" name="Requirements complete? [Admissions]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#FEF9C3</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#CA8A04</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#FEF9C3"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#CA8A04"/>
      </bpmn:extensionElements>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="A7_0" name="A7.0 — Officially Admitted [Admissions]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#D1FAE5</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#059669</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#D1FAE5"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#059669"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="A7_1" name="A7.1 — Provisionally Admitted [Admissions]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#D1FAE5</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#059669</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#D1FAE5"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#059669"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S1_0" name="S1.0 — Without Enrollment [Registrar]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#EDE9FE</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#7C3AED</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#EDE9FE"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#7C3AED"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Student" name="Student status continues [Registrar]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#FEE2E2</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#DC2626</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#FEE2E2"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#DC2626"/>
      </bpmn:extensionElements>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="A6_0" name="Acceptance fee paid/waived"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="A6_0" targetRef="GW_Req"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="GW_Req" targetRef="A7_0" name="Complete"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="GW_Req" targetRef="A7_1" name="Pending"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="A7_1" targetRef="A7_0" name="Requirements completed"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="A7_0" targetRef="S1_0" name="Becomes student"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="A7_1" targetRef="S1_0" name="Becomes student (provisional)"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="S1_0" targetRef="End_Student"/>
  </bpmn:process>
