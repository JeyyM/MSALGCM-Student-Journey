        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#D97706"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="T001_Trig" targetRef="T001_Eff" name="forces"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="T003_Trig" targetRef="T003_Eff" name="forces"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="T004_Trig" targetRef="T004_Eff" name="forces"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="T004_Eff" targetRef="T005_Eff" name="shift approved"/>
