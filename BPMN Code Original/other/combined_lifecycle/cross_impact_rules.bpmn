<?xml version="1.0" ?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_Combined_CrossImpactRules" targetNamespace="http://dlsu.edu.ph/student-journey">
  <bpmn:collaboration id="Collaboration_Combined_CrossImpactRules">
    <bpmn:participant id="Participant_Combined_CrossImpactRules" name="Combined — Cross-Impact Rules (COMBO-T001–T005)" processRef="Combined_CrossImpactRules"/>
  </bpmn:collaboration>
  <bpmn:process id="Combined_CrossImpactRules" name="Combined — Cross-Impact Rules (COMBO-T001–T005)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Combined_CrossImpactRules">
      <bpmn:lane id="Lane_program_lane" name="Program Office">
        <bpmn:flowNodeRef>T001_Trig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T003_Eff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T004_Trig</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_student_lane" name="Student Records">
        <bpmn:flowNodeRef>T001_Eff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T003_Trig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T004_Eff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T005_Eff</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="T001_Trig" name="All programs → P3.0 Graduated [Program Office]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#CFFAFE</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#0891B2</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#CFFAFE"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#0891B2"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T001_Eff" name="COMBO-T001: Student → S4.0 [Registrar]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#FEF3C7</color:background-color>
