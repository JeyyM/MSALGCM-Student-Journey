<?xml version="1.0" ?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_Combined_HighLevelOverview" targetNamespace="http://dlsu.edu.ph/student-journey">
  <bpmn:collaboration id="Collaboration_Combined_HighLevelOverview">
    <bpmn:participant id="Participant_Combined_HighLevelOverview" name="Combined — High-Level Lifecycle Overview" processRef="Combined_HighLevelOverview"/>
  </bpmn:collaboration>
  <bpmn:process id="Combined_HighLevelOverview" name="Combined — High-Level Lifecycle Overview" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Combined_HighLevelOverview">
      <bpmn:lane id="Lane_applicant" name="Applicant / Prospective Student">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>APPLICANT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_admissions" name="Admissions Office">
        <bpmn:flowNodeRef>ACCEPTED</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_student_lane" name="Student Life &amp; Enrollment">
        <bpmn:flowNodeRef>ACTIVE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DISRUPT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_program_lane" name="Program / Academic Affairs">
        <bpmn:flowNodeRef>PROGRAM</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_outcome" name="University Outcome">
        <bpmn:flowNodeRef>OUTCOME</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Start [Applicant]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#DCFCE7</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#16A34A</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#DCFCE7"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#16A34A"/>
      </bpmn:extensionElements>
    </bpmn:startEvent>
    <bpmn:userTask id="APPLICANT" name="Applicant phase (A0–A5.x) [Applicant]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#DBEAFE</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#2563EB</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#DBEAFE"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#2563EB"/>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="ACCEPTED" name="Accepted (A6.0–A7.x) [Admissions]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#D1FAE5</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#059669</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#D1FAE5"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#059669"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ACTIVE" name="Active Student (S1.0–S2.x) [Enrollment]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#FEF3C7</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#D97706</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#FEF3C7"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#D97706"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PROGRAM" name="Program Standing (P1.0–P2.0) [Program Office]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#CFFAFE</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#0891B2</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#CFFAFE"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#0891B2"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="DISRUPT" name="LOA / AWOL / Suspended [Enrollment]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#FEF3C7</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#D97706</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#FEF3C7"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#D97706"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="OUTCOME" name="Graduation / Exit / Terminal [University]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#E5E7EB</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#374151</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#E5E7EB"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#374151"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="Terminal [University]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#FEE2E2</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#DC2626</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#FEE2E2"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#DC2626"/>
      </bpmn:extensionElements>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="APPLICANT"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="APPLICANT" targetRef="ACCEPTED" name="Admitted / reserved"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="APPLICANT" targetRef="OUTCOME" name="Rejected / cancelled"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="ACCEPTED" targetRef="ACTIVE" name="Becomes student"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="ACTIVE" targetRef="DISRUPT" name="Leave / discipline"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="DISRUPT" targetRef="ACTIVE" name="Returnee re-enrolls"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="ACTIVE" targetRef="OUTCOME" name="Graduate or exit"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="ACTIVE" targetRef="PROGRAM" name="Academic standing"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="PROGRAM" targetRef="OUTCOME" name="All programs graduated"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="OUTCOME" targetRef="End"/>
  </bpmn:process>
