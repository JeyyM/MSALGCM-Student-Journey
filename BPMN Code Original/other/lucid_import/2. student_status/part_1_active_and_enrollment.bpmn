<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Student_Part1_ActiveEnrollment" targetNamespace="http://dlsu.edu.ph/student-journey">
  <bpmn:process id="Student_Part1_ActiveEnrollment" name="S - Part 1: Active &amp; Enrollment" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Student_Part1_ActiveEnrollment">
      <bpmn:lane id="Lane_student" name="Student"/>
      <bpmn:lane id="Lane_registrar" name="Enrollment &amp; Records">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S1_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Next</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Officially admitted (A7.x)"/>
    <bpmn:task id="S1_0" name="S1.0 - Without Enrollment"/>
    <bpmn:task id="S2_0" name="S2.0 - Active"/>
    <bpmn:endEvent id="End_Next" name="Continues in Parts 2–4"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="S1_0"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="S1_0" targetRef="S2_0" name="Enrolled / enlisted"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="S2_0" targetRef="End_Next"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Student_Part1_ActiveEnrollment">
    <bpmndi:BPMNPlane id="BPMNPlane_Student_Part1_ActiveEnrollment" bpmnElement="Student_Part1_ActiveEnrollment">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="220" y="270" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S1_0_di" bpmnElement="S1_0">
        <dc:Bounds x="500" y="270" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S2_0_di" bpmnElement="S2_0">
        <dc:Bounds x="780" y="270" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Next_di" bpmnElement="End_Next">
        <dc:Bounds x="1060" y="270" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="256" y="289"/>
        <di:waypoint x="378" y="289"/>
        <di:waypoint x="378" y="301"/>
        <di:waypoint x="500" y="301"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="650" y="305"/>
        <di:waypoint x="780" y="305"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="930" y="299"/>
        <di:waypoint x="995" y="299"/>
        <di:waypoint x="995" y="289"/>
        <di:waypoint x="1060" y="289"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
