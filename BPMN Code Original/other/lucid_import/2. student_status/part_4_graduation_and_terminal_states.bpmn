<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Student_Part4_GraduationTerminal" targetNamespace="http://dlsu.edu.ph/student-journey">
  <bpmn:process id="Student_Part4_GraduationTerminal" name="S - Part 4: Graduation &amp; Terminal" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Student_Part4_GraduationTerminal">
      <bpmn:lane id="Lane_student" name="Student">
        <bpmn:flowNodeRef>S4_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_registrar" name="Enrollment &amp; Records">
        <bpmn:flowNodeRef>S2_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4_0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_disciplinary" name="Disciplinary Office">
        <bpmn:flowNodeRef>S4_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="S2_0" name="S2.0 - Active"/>
    <bpmn:endEvent id="S4_0" name="S4.0 - Graduated"/>
    <bpmn:endEvent id="S4_1" name="S4.1 - Exited (good standing)"/>
    <bpmn:endEvent id="S4_2" name="S4.2 - Disqualified"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="S2_0" targetRef="S4_0" name="All programs graduated"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="S2_0" targetRef="S4_1" name="University exit"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="S2_0" targetRef="S4_2" name="Disqualification"/>
  </bpmn:process>
