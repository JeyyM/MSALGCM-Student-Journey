<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Program_Part3_GraduationTerminal" targetNamespace="http://dlsu.edu.ph/student-journey">
  <bpmn:process id="Program_Part3_GraduationTerminal" name="P - Part 3: Graduation &amp; Terminal" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Program_Part3_GraduationTerminal">
      <bpmn:lane id="Lane_program" name="College / Program Office">
        <bpmn:flowNodeRef>P1_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_student" name="Student">
        <bpmn:flowNodeRef>P3_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="P1_0" name="P1.0 - Eligible"/>
    <bpmn:task id="P2_0" name="P2.0 - Candidate for Graduation"/>
    <bpmn:endEvent id="P3_1" name="P3.1 - Incomplete"/>
    <bpmn:endEvent id="P3_0" name="P3.0 - Graduated"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="P1_0" targetRef="P2_0" name="Graduation check passed"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="P2_0" targetRef="P3_0" name="Commencement + 1 week"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="P1_0" targetRef="P3_1" name="University exit"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="P2_0" targetRef="P3_1" name="University exit"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Program_Part3_GraduationTerminal">
    <bpmndi:BPMNPlane id="BPMNPlane_Program_Part3_GraduationTerminal" bpmnElement="Program_Part3_GraduationTerminal">
      <bpmndi:BPMNShape id="P1_0_di" bpmnElement="P1_0">
        <dc:Bounds x="220" y="125" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_0_di" bpmnElement="P2_0">
        <dc:Bounds x="820" y="125" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P3_1_di" bpmnElement="P3_1">
        <dc:Bounds x="1120" y="285" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P3_0_di" bpmnElement="P3_0">
        <dc:Bounds x="1420" y="125" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="370" y="160"/>
        <di:waypoint x="820" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="970" y="158"/>
        <di:waypoint x="1195" y="158"/>
        <di:waypoint x="1195" y="144"/>
        <di:waypoint x="1420" y="144"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="370" y="173"/>
        <di:waypoint x="370" y="236"/>
        <di:waypoint x="1120" y="236"/>
        <di:waypoint x="1120" y="300"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
