<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             id="def_applicant_status_part_1_account_to_submission"
             name="DMN applicant_status part_1_account_to_submission"
             namespace="https://studentjourneymatrix.local/applicant_status_part_1_account_to_submission">
  <decision id="decision_applicant_status_part_1_account_to_submission" name="Applicant Status — Part 1: Account to Submission">
    <decisionTable id="dt_applicant_status_part_1_account_to_submission" hitPolicy="UNIQUE">
      <input id="in1_applicant_status_part_1_account_to_submission" label="Current State">
        <inputExpression id="in1e_applicant_status_part_1_account_to_submission" typeRef="string">
          <text>current_state</text>
        </inputExpression>
      </input>
      <input id="in2_applicant_status_part_1_account_to_submission" label="Event / Outcome">
        <inputExpression id="in2e_applicant_status_part_1_account_to_submission" typeRef="string">
          <text>event</text>
        </inputExpression>
      </input>
      <output id="out1_applicant_status_part_1_account_to_submission" label="Next State" name="next_state" typeRef="string"/>
      <rule id="row_applicant_status_part_1_account_to_submission_1">
        <inputEntry id="row_applicant_status_part_1_account_to_submission_1_i1"><text>"(none — new account)"</text></inputEntry>
        <inputEntry id="row_applicant_status_part_1_account_to_submission_1_i2"><text>"Account created"</text></inputEntry>
        <outputEntry id="row_applicant_status_part_1_account_to_submission_1_o1"><text>"A0 — Draft [Applicant]"</text></outputEntry>
      </rule>
      <rule id="row_applicant_status_part_1_account_to_submission_2">
        <inputEntry id="row_applicant_status_part_1_account_to_submission_2_i1"><text>"A0 — Draft [Applicant]"</text></inputEntry>
        <inputEntry id="row_applicant_status_part_1_account_to_submission_2_i2"><text>"Application submitted"</text></inputEntry>
        <outputEntry id="row_applicant_status_part_1_account_to_submission_2_o1"><text>"A1.0 — Submitted Form [Applicant]"</text></outputEntry>
      </rule>
      <rule id="row_applicant_status_part_1_account_to_submission_3">
        <inputEntry id="row_applicant_status_part_1_account_to_submission_3_i1"><text>"A1.0 — Submitted Form [Applicant]"</text></inputEntry>
        <inputEntry id="row_applicant_status_part_1_account_to_submission_3_i2"><text>"Complete"</text></inputEntry>
        <outputEntry id="row_applicant_status_part_1_account_to_submission_3_o1"><text>"A2.0 — Complete Requirements [OAS]"</text></outputEntry>
      </rule>
      <rule id="row_applicant_status_part_1_account_to_submission_4">
        <inputEntry id="row_applicant_status_part_1_account_to_submission_4_i1"><text>"A1.0 — Submitted Form [Applicant]"</text></inputEntry>
        <inputEntry id="row_applicant_status_part_1_account_to_submission_4_i2"><text>"Deficiencies"</text></inputEntry>
        <outputEntry id="row_applicant_status_part_1_account_to_submission_4_o1"><text>"A2.1 — Deficiencies [OAS]"</text></outputEntry>
      </rule>
      <rule id="row_applicant_status_part_1_account_to_submission_5">
        <inputEntry id="row_applicant_status_part_1_account_to_submission_5_i1"><text>"A2.1 — Deficiencies [OAS]"</text></inputEntry>
        <inputEntry id="row_applicant_status_part_1_account_to_submission_5_i2"><text>"Requirements completed"</text></inputEntry>
        <outputEntry id="row_applicant_status_part_1_account_to_submission_5_o1"><text>"A2.0 — Complete Requirements [OAS]"</text></outputEntry>
      </rule>
      <rule id="row_applicant_status_part_1_account_to_submission_6">
        <inputEntry id="row_applicant_status_part_1_account_to_submission_6_i1"><text>"A2.0 — Complete Requirements [OAS]"</text></inputEntry>
        <inputEntry id="row_applicant_status_part_1_account_to_submission_6_i2"><text>"OAS requires resubmit"</text></inputEntry>
        <outputEntry id="row_applicant_status_part_1_account_to_submission_6_o1"><text>"A2.1 — Deficiencies [OAS]"</text></outputEntry>
      </rule>
      <rule id="row_applicant_status_part_1_account_to_submission_7">
        <inputEntry id="row_applicant_status_part_1_account_to_submission_7_i1"><text>"A2.0 — Complete Requirements [OAS]"</text></inputEntry>
        <inputEntry id="row_applicant_status_part_1_account_to_submission_7_i2"><text>"Proceed"</text></inputEntry>
        <outputEntry id="row_applicant_status_part_1_account_to_submission_7_o1"><text>"-&gt; Part 2A: Initial Evaluation"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
