<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Applicant_Part1_AccountToSubmission" targetNamespace="http://dlsu.edu.ph/student-journey" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0">
  <bpmn:collaboration id="Collaboration_Applicant_Part1_AccountToSubmission">
    <bpmn:participant id="Participant_Applicant_Part1_AccountToSubmission" name="A — Part 1: Account to Submission" processRef="Applicant_Part1_AccountToSubmission" />
  </bpmn:collaboration>
  <bpmn:process id="Applicant_Part1_AccountToSubmission" name="A — Part 1: Account to Submission" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Applicant_Part1_AccountToSubmission">
      <bpmn:lane id="Lane_applicant" name="Applicant">
        <bpmn:flowNodeRef>A0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_oas" name="OAS / Admissions Office">
        <bpmn:flowNodeRef>GW_Req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Next</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="A0" name="A0 — Draft [Applicant]">
      <bpmn:extensionElements />
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Req" name="Requirements OK? [OAS]">
      <bpmn:extensionElements />
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="A2_0" name="A2.0 — Complete Requirements [OAS]">
      <bpmn:extensionElements />
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1" name="Account created" sourceRef="Start" targetRef="A0" />
    <bpmn:sequenceFlow id="Flow_2" name="Application submitted" sourceRef="A0" targetRef="A1_0" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="A1_0" targetRef="GW_Req" />
    <bpmn:sequenceFlow id="Flow_4" name="Complete" sourceRef="GW_Req" targetRef="A2_0" />
    <bpmn:sequenceFlow id="Flow_5" name="Deficiencies" sourceRef="GW_Req" targetRef="A2_1" />
    <bpmn:sequenceFlow id="Flow_6" name="Requirements completed" sourceRef="A2_1" targetRef="A2_0" />
    <bpmn:sequenceFlow id="Flow_7" name="OAS requires resubmit" sourceRef="A2_0" targetRef="A2_1" />
    <bpmn:sequenceFlow id="Flow_8" name="Proceed" sourceRef="A2_0" targetRef="End_Next" />
    <bpmn:userTask id="A1_0" name="A1.0 — Submitted Form [Applicant]">
      <bpmn:extensionElements />
    </bpmn:userTask>
    <bpmn:startEvent id="Start" name="Account created [Applicant]">
      <bpmn:extensionElements />
    </bpmn:startEvent>
    <bpmn:serviceTask id="A2_1" name="A2.1 — Deficiencies [OAS]">
      <bpmn:extensionElements />
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Next" name="Continue to evaluation [OAS]">
      <bpmn:extensionElements />
    </bpmn:endEvent>
  </bpmn:process>
