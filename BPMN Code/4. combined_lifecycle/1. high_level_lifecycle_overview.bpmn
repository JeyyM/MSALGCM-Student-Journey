<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Combined_HighLevelOverview" targetNamespace="http://dlsu.edu.ph/student-journey" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0">
  <bpmn:collaboration id="Collaboration_Combined_HighLevelOverview">
    <bpmn:participant id="Participant_Combined_HighLevelOverview" name="Combined — High-Level Lifecycle Overview" processRef="Combined_HighLevelOverview" />
  </bpmn:collaboration>
  <bpmn:process id="Combined_HighLevelOverview" name="Combined — High-Level Lifecycle Overview" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Combined_HighLevelOverview">
      <bpmn:lane id="Lane_applicant" name="Applicant / Prospective Student">
        <bpmn:flowNodeRef>APPLICANT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_admissions" name="Admissions Office">
        <bpmn:flowNodeRef>ACCEPTED</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_student_lane" name="Student Life &amp; Enrollment">
        <bpmn:flowNodeRef>ACTIVE</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_program_lane" name="Program / Academic Affairs">
        <bpmn:flowNodeRef>PROGRAM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DISRUPT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_outcome" name="University Outcome">
        <bpmn:flowNodeRef>OUTCOME</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_8" name="Academic standing tracked per program" sourceRef="ACTIVE" targetRef="PROGRAM" />
    <bpmn:sequenceFlow id="Flow_5" name="Leave / absence / discipline" sourceRef="ACTIVE" targetRef="DISRUPT" />
    <bpmn:sequenceFlow id="Flow_6" name="Returnee re-enrolls" sourceRef="DISRUPT" targetRef="ACTIVE" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="OUTCOME" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_9" name="All programs graduated" sourceRef="PROGRAM" targetRef="OUTCOME" />
    <bpmn:sequenceFlow id="Flow_7" name="Graduate or exit" sourceRef="ACTIVE" targetRef="OUTCOME" />
    <bpmn:sequenceFlow id="Flow_4" name="Becomes student, enrolls" sourceRef="ACCEPTED" targetRef="ACTIVE" />
    <bpmn:sequenceFlow id="Flow_3" name="Rejected / cancelled" sourceRef="APPLICANT" targetRef="OUTCOME" />
    <bpmn:sequenceFlow id="Flow_2" name="Admitted / reserved" sourceRef="APPLICANT" targetRef="ACCEPTED" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="APPLICANT" />
    <bpmn:endEvent id="End" name="Terminal [University]">
      <bpmn:extensionElements />
    </bpmn:endEvent>
    <bpmn:serviceTask id="DISRUPT" name="LOA / AWOL / Suspended [Enrollment]">
      <bpmn:extensionElements />
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PROGRAM" name="Program Standing (P1.0–P2.0) [Program Office]">
      <bpmn:extensionElements />
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ACTIVE" name="Active Student (S1.0–S2.x) [Enrollment]">
      <bpmn:extensionElements />
    </bpmn:serviceTask>
    <bpmn:startEvent id="Start" name="Start [Applicant]">
      <bpmn:extensionElements />
    </bpmn:startEvent>
    <bpmn:serviceTask id="OUTCOME" name="Graduation / Exit / Terminal [University]">
      <bpmn:extensionElements />
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ACCEPTED" name="Accepted (A6.0–A7.x) [Admissions]">
      <bpmn:extensionElements />
    </bpmn:serviceTask>
    <bpmn:userTask id="APPLICANT" name="Applicant phase (A0–A5.x) [Applicant]">
      <bpmn:extensionElements />
    </bpmn:userTask>
  </bpmn:process>
