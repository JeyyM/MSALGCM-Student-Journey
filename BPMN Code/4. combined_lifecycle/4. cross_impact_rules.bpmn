  <bpmn:collaboration id="Collaboration_Combined_CrossImpactRules">
    <bpmn:participant id="Participant_Combined_CrossImpactRules" name="Combined — Cross-Impact Rules (COMBO-T001–T005)" processRef="Combined_CrossImpactRules" />
