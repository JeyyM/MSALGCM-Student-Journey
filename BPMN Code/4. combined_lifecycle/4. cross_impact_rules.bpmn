        <bpmn:flowNodeRef>T005_Eff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T001_Eff</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_1" name="forces" sourceRef="T001_Trig" targetRef="T001_Eff" />
    <bpmn:sequenceFlow id="Flow_2" name="forces" sourceRef="T003_Trig" targetRef="T003_Eff" />
    <bpmn:sequenceFlow id="Flow_3" name="forces" sourceRef="T004_Trig" targetRef="T004_Eff" />
    <bpmn:sequenceFlow id="Flow_4" name="shift approved" sourceRef="T004_Eff" targetRef="T005_Eff" />
    <bpmn:serviceTask id="T001_Trig" name="All programs → P3.0 Graduated [Program Office]">
