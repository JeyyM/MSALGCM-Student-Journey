  <bpmn:process id="Combined_CrossImpactRules" name="Combined — Cross-Impact Rules (COMBO-T001–T005)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Combined_CrossImpactRules">
      <bpmn:lane id="Lane_program_lane" name="Program Office">
        <bpmn:flowNodeRef>T001_Trig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T004_Trig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T003_Eff</bpmn:flowNodeRef>
