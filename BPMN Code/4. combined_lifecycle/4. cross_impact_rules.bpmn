    </bpmn:serviceTask>
    <bpmn:serviceTask id="T004_Trig" name="P1.4 Ineligible + shift pending [Program Office]">
      <bpmn:extensionElements />
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T003_Eff" name="COMBO-T003: Program → P3.1 [Program Office]">
      <bpmn:extensionElements />
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T004_Eff" name="COMBO-T004: Student → S1.0 [Registrar]">
      <bpmn:extensionElements />
    </bpmn:serviceTask>
    <bpmn:userTask id="T003_Trig" name="Student exit, program active [Student]">
      <bpmn:extensionElements />
    </bpmn:userTask>
    <bpmn:serviceTask id="T005_Eff" name="COMBO-T005: Shift approved → S2.0 [Registrar]">
      <bpmn:extensionElements />
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T001_Eff" name="COMBO-T001: Student → S4.0 [Registrar]">
      <bpmn:extensionElements />
    </bpmn:serviceTask>
  </bpmn:process>
