             id="def_6__combination_matrix_validation"
             name="DMN applicant_status 6__combination_matrix_validation"
             namespace="https://studentjourneymatrix.local/6__combination_matrix_validation">
  <decision id="decision_combination_matrix_validation" name="Student × Program Combination Validation (Post-M3)">
    <decisionTable id="dt_combination_matrix_validation" hitPolicy="UNIQUE">
      <input id="in1_combination_matrix_validation" label="Student Status Code">
        <inputExpression id="in1e_combination_matrix_validation" typeRef="string">
          <text>student_code</text>
        </inputExpression>
      </input>
      <input id="in2_combination_matrix_validation" label="Program Status Code">
        <inputExpression id="in2e_combination_matrix_validation" typeRef="string">
          <text>program_code</text>
        </inputExpression>
      </input>
      <output id="out1_combination_matrix_validation" label="Allowed" name="allowed" typeRef="string"/>
      <output id="out2_combination_matrix_validation" label="Rationale" name="rationale" typeRef="string"/>
      <rule id="row_combination_matrix_validation_1">
        <inputEntry id="row_combination_matrix_validation_1_i1"><text>"S1.0"</text></inputEntry>
        <inputEntry id="row_combination_matrix_validation_1_i2"><text>"P1.0"</text></inputEntry>
        <outputEntry id="row_combination_matrix_validation_1_o1"><text>"YES"</text></outputEntry>
        <outputEntry id="row_combination_matrix_validation_1_o2"><text>"Admitted/returnee; eligible program standing before enrollment."</text></outputEntry>
