<?xml version="1.0" ?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_Combined_StudentProgramInteraction" targetNamespace="http://dlsu.edu.ph/student-journey">
  <bpmn:collaboration id="Collaboration_Combined_StudentProgramInteraction">
    <bpmn:participant id="Participant_Combined_StudentProgramInteraction" name="Combined — Student vs Program Interaction" processRef="Combined_StudentProgramInteraction"/>
  </bpmn:collaboration>
  <bpmn:process id="Combined_StudentProgramInteraction" name="Combined — Student vs Program Interaction" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Combined_StudentProgramInteraction">
      <bpmn:lane id="Lane_program_lane" name="Program Office">
        <bpmn:flowNodeRef>PALL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PINC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PINE</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_student_lane" name="Student Records">
        <bpmn:flowNodeRef>SGRAD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SEXIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SAWE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SACT</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="PALL" name="All programs → P3.0 Graduated [Program Office]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#CFFAFE</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#0891B2</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#CFFAFE"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#0891B2"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="SGRAD" name="Student → S4.0 Graduated [Registrar]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#FEF3C7</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#D97706</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#FEF3C7"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#D97706"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="SEXIT" name="Student exit, program active [Student]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#FEF3C7</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#D97706</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#FEF3C7"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#D97706"/>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="PINC" name="Program → P3.1 Incomplete [Program Office]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#CFFAFE</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#0891B2</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#CFFAFE"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#0891B2"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PINE" name="P1.4 Ineligible + shift pending [Program Office]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#CFFAFE</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#0891B2</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#CFFAFE"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#0891B2"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="SAWE" name="Student → S1.0 Without Enrollment [Registrar]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#FEF3C7</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#D97706</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#FEF3C7"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#D97706"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="SACT" name="Student → S2.0 Active [Registrar]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#FEF3C7</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#D97706</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#FEF3C7"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#D97706"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="PALL" targetRef="SGRAD" name="forces"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="SEXIT" targetRef="PINC" name="forces"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="PINE" targetRef="SAWE" name="forces"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="SAWE" targetRef="SACT" name="shift approved"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Combined_StudentProgramInteraction">
    <bpmndi:BPMNPlane id="BPMNPlane_Combined_StudentProgramInteraction" bpmnElement="Collaboration_Combined_StudentProgramInteraction">
      <bpmndi:BPMNShape id="Participant_Combined_StudentProgramInteraction_di" bpmnElement="Participant_Combined_StudentProgramInteraction" isHorizontal="true">
