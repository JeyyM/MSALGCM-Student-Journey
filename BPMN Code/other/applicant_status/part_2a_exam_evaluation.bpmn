<?xml version="1.0" ?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_Applicant_Part2a_ExamEvaluation" targetNamespace="http://dlsu.edu.ph/student-journey">
  <bpmn:collaboration id="Collaboration_Applicant_Part2a_ExamEvaluation">
    <bpmn:participant id="Participant_Applicant_Part2a_ExamEvaluation" name="A — Part 2A: Exam &amp; Evaluation" processRef="Applicant_Part2a_ExamEvaluation"/>
  </bpmn:collaboration>
  <bpmn:process id="Applicant_Part2a_ExamEvaluation" name="A — Part 2A: Exam &amp; Evaluation" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Applicant_Part2a_ExamEvaluation">
      <bpmn:lane id="Lane_applicant" name="Applicant">
        <bpmn:flowNodeRef>A4_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_oas" name="OAS / Admissions Office">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Init</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Results</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="From A2.0 complete [OAS]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#DCFCE7</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#16A34A</color:border-color>
