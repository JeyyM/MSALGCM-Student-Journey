      </bpmn:extensionElements>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="GW_Init"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="GW_Init" targetRef="A3_0" name="Exam required"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="GW_Init" targetRef="A3_1" name="Exam exempted"/>
