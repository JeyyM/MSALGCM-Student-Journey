    <bpmn:sequenceFlow id="Flow_5" sourceRef="GW_Init" targetRef="A4_3" name="Further screening only"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="A3_0" targetRef="GW_Exam"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="GW_Exam" targetRef="A4_0" name="Exam taken"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="GW_Exam" targetRef="A4_1" name="Exam pending"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="GW_Exam" targetRef="A4_2" name="Exam window lapsed"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="A4_1" targetRef="A4_0" name="Exam taken"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="A4_1" targetRef="A4_2" name="Exam window lapsed"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="A4_0" targetRef="A4_3" name="Further screening"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="A3_1" targetRef="End_Results"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="A4_3" targetRef="End_Results"/>
