<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Applicant_Part2b_AdmissionResults" targetNamespace="http://dlsu.edu.ph/student-journey">
  <bpmn:process id="Applicant_Part2b_AdmissionResults" name="A - Part 2B: Admission Results" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Applicant_Part2b_AdmissionResults">
      <bpmn:lane id="Lane_applicant" name="Applicant">
        <bpmn:flowNodeRef>End_Accept</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_oas" name="OAS / Admissions Office">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A5_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A5_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A5_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A5_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A5_0</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="After evaluation"/>
    <bpmn:exclusiveGateway id="GW_Decision" name="Admission decision"/>
    <bpmn:task id="A5_1" name="A5.1 - Probationary"/>
    <bpmn:task id="A5_2" name="A5.2 - Redirected"/>
    <bpmn:task id="A5_3" name="A5.3 - Waitlisted"/>
    <bpmn:endEvent id="A5_5" name="A5.5 - Not Qualified"/>
    <bpmn:task id="A5_0" name="A5.0 - Offered"/>
    <bpmn:endEvent id="End_Accept" name="Continue to acceptance"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="GW_Decision"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="GW_Decision" targetRef="A5_0" name="Within cutoff"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="GW_Decision" targetRef="A5_1" name="Probationary"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="GW_Decision" targetRef="A5_2" name="Redirected"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="GW_Decision" targetRef="A5_3" name="Waitlisted"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="GW_Decision" targetRef="A5_5" name="Outside cutoff"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="A5_3" targetRef="A5_0" name="Slot opened"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="A5_0" targetRef="End_Accept" name="Offer received"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="A5_1" targetRef="End_Accept" name="Offer received"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="A5_2" targetRef="End_Accept" name="Offer received"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Applicant_Part2b_AdmissionResults">
    <bpmndi:BPMNPlane id="BPMNPlane_Applicant_Part2b_AdmissionResults" bpmnElement="Applicant_Part2b_AdmissionResults">
