<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Applicant_Part3_AcceptanceToStudent" targetNamespace="http://dlsu.edu.ph/student-journey">
  <bpmn:process id="Applicant_Part3_AcceptanceToStudent" name="A - Part 3: Acceptance to Student" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Applicant_Part3_AcceptanceToStudent">
      <bpmn:lane id="Lane_applicant" name="Applicant">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_oas" name="OAS / Admissions Office">
        <bpmn:flowNodeRef>A6_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A7_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A7_0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_registrar" name="University Records (Registrar)">
        <bpmn:flowNodeRef>S1_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Student</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Admission offer"/>
    <bpmn:task id="A6_0" name="A6.0 - Reserved"/>
    <bpmn:exclusiveGateway id="GW_Req" name="Requirements complete?"/>
    <bpmn:task id="A7_1" name="A7.1 - Provisionally Admitted"/>
    <bpmn:task id="A7_0" name="A7.0 - Officially Admitted"/>
    <bpmn:task id="S1_0" name="S1.0 - Without Enrollment"/>
    <bpmn:endEvent id="End_Student" name="Student status continues"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="A6_0" name="Acceptance fee paid/waived"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="A6_0" targetRef="GW_Req"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="GW_Req" targetRef="A7_0" name="Complete"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="GW_Req" targetRef="A7_1" name="Pending"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="A7_1" targetRef="A7_0" name="Requirements completed"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="A7_0" targetRef="S1_0" name="Becomes student"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="A7_1" targetRef="S1_0" name="Becomes student (provisional)"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="S1_0" targetRef="End_Student"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Applicant_Part3_AcceptanceToStudent">
    <bpmndi:BPMNPlane id="BPMNPlane_Applicant_Part3_AcceptanceToStudent" bpmnElement="Applicant_Part3_AcceptanceToStudent">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="220" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A6_0_di" bpmnElement="A6_0">
        <dc:Bounds x="500" y="285" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Req_di" bpmnElement="GW_Req" isMarkerVisible="true">
        <dc:Bounds x="780" y="295" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A7_1_di" bpmnElement="A7_1">
        <dc:Bounds x="1060" y="220" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A7_0_di" bpmnElement="A7_0">
        <dc:Bounds x="1340" y="285" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S1_0_di" bpmnElement="S1_0">
        <dc:Bounds x="1620" y="450" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Student_di" bpmnElement="End_Student">
        <dc:Bounds x="1900" y="450" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="256" y="148"/>
        <di:waypoint x="256" y="216"/>
        <di:waypoint x="510" y="216"/>
        <di:waypoint x="510" y="285"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="650" y="320"/>
        <di:waypoint x="780" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="830" y="320"/>
        <di:waypoint x="1340" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="830" y="315"/>
        <di:waypoint x="945" y="315"/>
        <di:waypoint x="945" y="270"/>
        <di:waypoint x="1060" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1210" y="272"/>
        <di:waypoint x="1275" y="272"/>
        <di:waypoint x="1275" y="303"/>
        <di:waypoint x="1340" y="303"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1474" y="355"/>
        <di:waypoint x="1474" y="402"/>
        <di:waypoint x="1636" y="402"/>
        <di:waypoint x="1636" y="450"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1210" y="286"/>
        <di:waypoint x="1210" y="370"/>
        <di:waypoint x="1620" y="370"/>
        <di:waypoint x="1620" y="454"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1770" y="479"/>
        <di:waypoint x="1835" y="479"/>
        <di:waypoint x="1835" y="469"/>
        <di:waypoint x="1900" y="469"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
