    <bpmn:sequenceFlow id="Flow_3" sourceRef="S1_0" targetRef="S2_0" name="Enrolled / enlisted"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="S1_0" targetRef="P1_0" name="Normal admission"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="S1_0" targetRef="P1_1" name="Probationary offer"/>
  </bpmn:process>
