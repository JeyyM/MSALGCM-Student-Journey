<?xml version="1.0" ?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_Program_Part1_GoodStandingProbation" targetNamespace="http://dlsu.edu.ph/student-journey">
  <bpmn:collaboration id="Collaboration_Program_Part1_GoodStandingProbation">
    <bpmn:participant id="Participant_Program_Part1_GoodStandingProbation" name="P — Part 1: Good Standing &amp; Probation" processRef="Program_Part1_GoodStandingProbation"/>
  </bpmn:collaboration>
  <bpmn:process id="Program_Part1_GoodStandingProbation" name="P — Part 1: Good Standing &amp; Probation" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Program_Part1_GoodStandingProbation">
      <bpmn:lane id="Lane_program" name="College / Program Office">
        <bpmn:flowNodeRef>Start_N</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_P</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Next</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_student" name="Student"/>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_N" name="Normal admission [Program Office]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#DCFCE7</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#16A34A</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#DCFCE7"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#16A34A"/>
      </bpmn:extensionElements>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_P" name="Probationary offer [Program Office]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#DCFCE7</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#16A34A</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#DCFCE7"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#16A34A"/>
      </bpmn:extensionElements>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P1_0" name="P1.0 — Eligible [Program Office]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#CFFAFE</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#0891B2</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#CFFAFE"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#0891B2"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P1_1" name="P1.1 — Probationary [Program Office]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#CFFAFE</color:background-color>
