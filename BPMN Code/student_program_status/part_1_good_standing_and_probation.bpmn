        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#DC2626"/>
      </bpmn:extensionElements>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_N" targetRef="P1_0"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Start_P" targetRef="P1_1"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="P1_0" targetRef="P1_1" name="Standards not met"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="P1_1" targetRef="P1_0" name="Probation lifted"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="P1_0" targetRef="End_Next"/>
  </bpmn:process>
