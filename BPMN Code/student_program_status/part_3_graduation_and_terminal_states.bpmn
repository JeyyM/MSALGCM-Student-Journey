<?xml version="1.0" ?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_Program_Part3_GraduationTerminal" targetNamespace="http://dlsu.edu.ph/student-journey">
  <bpmn:collaboration id="Collaboration_Program_Part3_GraduationTerminal">
    <bpmn:participant id="Participant_Program_Part3_GraduationTerminal" name="P — Part 3: Graduation &amp; Terminal" processRef="Program_Part3_GraduationTerminal"/>
  </bpmn:collaboration>
  <bpmn:process id="Program_Part3_GraduationTerminal" name="P — Part 3: Graduation &amp; Terminal" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Program_Part3_GraduationTerminal">
      <bpmn:lane id="Lane_program" name="College / Program Office">
        <bpmn:flowNodeRef>P1_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_student" name="Student">
        <bpmn:flowNodeRef>P3_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="P1_0" name="P1.0 — Eligible [Program Office]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#CFFAFE</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#0891B2</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#CFFAFE"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#0891B2"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P2_0" name="P2.0 — Candidate for Graduation [Program Office]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#CFFAFE</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#0891B2</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#CFFAFE"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#0891B2"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P3_0" name="P3.0 — Graduated [Program Office]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#FEE2E2</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#DC2626</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#FEE2E2"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#DC2626"/>
      </bpmn:extensionElements>
    </bpmn:endEvent>
    <bpmn:endEvent id="P3_1" name="P3.1 — Incomplete [Student]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#FEE2E2</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#DC2626</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#FEE2E2"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#DC2626"/>
      </bpmn:extensionElements>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="P1_0" targetRef="P2_0" name="Graduation check passed"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="P2_0" targetRef="P3_0" name="Commencement + 1 week"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="P1_0" targetRef="P3_1" name="University exit"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="P2_0" targetRef="P3_1" name="University exit"/>
  </bpmn:process>
