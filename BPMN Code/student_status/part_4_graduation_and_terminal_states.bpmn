      <bpmn:lane id="Lane_student" name="Student">
        <bpmn:flowNodeRef>S4_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_registrar" name="Enrollment &amp; Records">
        <bpmn:flowNodeRef>S2_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4_0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_disciplinary" name="Disciplinary Office">
        <bpmn:flowNodeRef>S4_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="S2_0" name="S2.0 — Active [Registrar]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#EDE9FE</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#7C3AED</color:border-color>
