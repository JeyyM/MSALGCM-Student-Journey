        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#DC2626"/>
      </bpmn:extensionElements>
    </bpmn:endEvent>
    <bpmn:endEvent id="S4_1" name="S4.1 — Exited (good standing) [Student]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#FEE2E2</color:background-color>
