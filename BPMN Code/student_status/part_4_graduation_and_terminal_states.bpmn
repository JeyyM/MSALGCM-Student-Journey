        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#DC2626"/>
      </bpmn:extensionElements>
    </bpmn:endEvent>
    <bpmn:endEvent id="S4_2" name="S4.2 — Disqualified [Disciplinary]">
