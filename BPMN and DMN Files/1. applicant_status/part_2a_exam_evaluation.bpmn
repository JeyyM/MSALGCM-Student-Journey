  </bpmn:collaboration>
  <bpmn:process id="Applicant_Part2a_ExamEvaluation" name="A — Part 2A: Exam &amp; Evaluation" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Applicant_Part2a_ExamEvaluation">
      <bpmn:lane id="Lane_applicant" name="Applicant">
        <bpmn:flowNodeRef>A4_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_oas" name="OAS / Admissions Office">
        <bpmn:flowNodeRef>End_Results</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Init</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Exam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_0</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:endEvent id="End_Results" name="To admission results [OAS]">
      <bpmn:extensionElements />
    </bpmn:endEvent>
    <bpmn:userTask id="A4_1" name="A4.1 — Exam Pending [Applicant]">
      <bpmn:extensionElements />
    </bpmn:userTask>
    <bpmn:userTask id="A4_0" name="A4.0 — Exam Taken [Applicant]">
      <bpmn:extensionElements />
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="GW_Init" />
    <bpmn:sequenceFlow id="Flow_2" name="Exam required" sourceRef="GW_Init" targetRef="A3_0" />
    <bpmn:sequenceFlow id="Flow_3" name="Exam exempted" sourceRef="GW_Init" targetRef="A3_1" />
    <bpmn:sequenceFlow id="Flow_4" name="Failed initial eval" sourceRef="GW_Init" targetRef="A3_2" />
    <bpmn:sequenceFlow id="Flow_5" name="Further screening only" sourceRef="GW_Init" targetRef="A4_3" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="A3_0" targetRef="GW_Exam" />
    <bpmn:sequenceFlow id="Flow_7" name="Exam pending" sourceRef="GW_Exam" targetRef="A4_1" />
    <bpmn:sequenceFlow id="Flow_8" name="Exam taken" sourceRef="GW_Exam" targetRef="A4_0" />
    <bpmn:sequenceFlow id="Flow_9" name="Exam window lapsed" sourceRef="GW_Exam" targetRef="A4_2" />
    <bpmn:sequenceFlow id="Flow_10" name="Exam taken" sourceRef="A4_1" targetRef="A4_0" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="A4_1" targetRef="A4_2" />
    <bpmn:sequenceFlow id="Flow_12" name="Further screening" sourceRef="A4_0" targetRef="A4_3" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="A3_1" targetRef="End_Results" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="A4_3" targetRef="End_Results" />
    <bpmn:startEvent id="Start" name="From A2.0 complete [OAS]">
      <bpmn:extensionElements />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_Init" name="Initial evaluation [OAS]">
      <bpmn:extensionElements />
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="A3_1" name="A3.1 — Exam Exempted [OAS]">
      <bpmn:extensionElements />
    </bpmn:serviceTask>
    <bpmn:endEvent id="A3_2" name="A3.2 — Not Qualified [OAS]">
      <bpmn:extensionElements />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_Exam" name="Exam outcome [OAS]">
      <bpmn:extensionElements />
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="A4_3" name="A4.3 — Further Evaluation [OAS]">
      <bpmn:extensionElements />
    </bpmn:serviceTask>
    <bpmn:serviceTask id="A3_0" name="A3.0 — Exam Required [OAS]">
      <bpmn:extensionElements />
    </bpmn:serviceTask>
    <bpmn:endEvent id="A4_2" name="A4.2 — Not Qualified (no exam) [Applicant]">
      <bpmn:extensionElements />
    </bpmn:endEvent>
  </bpmn:process>
