        <inputEntry id="row_program_status_part_2_snas_sap_and_ineligible_2_i2"><text>"SNAS criteria reached"</text></inputEntry>
        <outputEntry id="row_program_status_part_2_snas_sap_and_ineligible_2_o1"><text>"P1.2 — SNAS [Program Office]"</text></outputEntry>
