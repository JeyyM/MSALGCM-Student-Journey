        <inputEntry id="row_program_status_part_2_snas_sap_and_ineligible_5_i1"><text>"P1.2 — SNAS [Program Office]"</text></inputEntry>
        <inputEntry id="row_program_status_part_2_snas_sap_and_ineligible_5_i2"><text>"(transition)"</text></inputEntry>
