        <inputEntry id="row_program_status_part_2_snas_sap_and_ineligible_3_i1"><text>"P1.1 — Probationary [Program Office]"</text></inputEntry>
        <inputEntry id="row_program_status_part_2_snas_sap_and_ineligible_3_i2"><text>"Retention breached"</text></inputEntry>
        <outputEntry id="row_program_status_part_2_snas_sap_and_ineligible_3_o1"><text>"P1.4 — Ineligible [Program Office]"</text></outputEntry>
        <outputEntry id="row_program_status_part_2_snas_sap_and_ineligible_3_o2"><text>"Derived from canonical BPMN sequence flow."</text></outputEntry>
      </rule>
      <rule id="row_program_status_part_2_snas_sap_and_ineligible_4">
        <inputEntry id="row_program_status_part_2_snas_sap_and_ineligible_4_i1"><text>"P1.1 — Probationary [Program Office]"</text></inputEntry>
        <inputEntry id="row_program_status_part_2_snas_sap_and_ineligible_4_i2"><text>"Strict probation (IS)"</text></inputEntry>
