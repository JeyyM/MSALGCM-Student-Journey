        <inputEntry id="row_program_status_part_2_snas_sap_and_ineligible_6_i2"><text>"SNAS criteria not reached"</text></inputEntry>
        <outputEntry id="row_program_status_part_2_snas_sap_and_ineligible_6_o1"><text>"P1.0 — Eligible [Program Office]"</text></outputEntry>
