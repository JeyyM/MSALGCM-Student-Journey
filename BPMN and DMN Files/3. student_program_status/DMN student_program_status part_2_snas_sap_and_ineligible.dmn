  <decision id="decision_program_status_part_2_snas_sap_and_ineligible" name="Program Status — Part 2: SNAS, SAP &amp; Ineligible">
    <decisionTable id="dt_program_status_part_2_snas_sap_and_ineligible" hitPolicy="UNIQUE">
      <input id="in1_program_status_part_2_snas_sap_and_ineligible" label="Current State">
