      <output id="out1_program_status_part_2_snas_sap_and_ineligible" label="Next State" name="next_state" typeRef="string"/>
      <output id="out2_program_status_part_2_snas_sap_and_ineligible" label="Rationale" name="rationale" typeRef="string"/>
      <rule id="row_program_status_part_2_snas_sap_and_ineligible_1">
        <inputEntry id="row_program_status_part_2_snas_sap_and_ineligible_1_i1"><text>"P1.0 — Eligible [Program Office]"</text></inputEntry>
        <inputEntry id="row_program_status_part_2_snas_sap_and_ineligible_1_i2"><text>"(transition)"</text></inputEntry>
        <outputEntry id="row_program_status_part_2_snas_sap_and_ineligible_1_o1"><text>"P1.4 — Ineligible [Program Office]"</text></outputEntry>
        <outputEntry id="row_program_status_part_2_snas_sap_and_ineligible_1_o2"><text>"Derived from canonical BPMN sequence flow."</text></outputEntry>
      </rule>
      <rule id="row_program_status_part_2_snas_sap_and_ineligible_2">
