%% Machine type: Parallel FSM with validation matrix (constrained product automaton)
%% Student + Program dimensions run in parallel; combination tab validates (S,P) pairs.
%% Cross-dimension impacts: COMBO-T001, T003, T004, T005 only (dotted edges).
%% Full 91-cell matrix: documentation/status_combination_rules.md (not drawn as edges).
%% Per-dimension detail: student_status/*.mmd and student_program_status/*.mmd
%% Layout: each FSM is a left-to-right lane; lanes + validation stack top-to-bottom.

flowchart TB
    HANDOFF([Admitted from A7.x]) --> S1_0

    subgraph STUDENT["Student FSM — University standing"]
        direction LR
        S1_0["S1.0 Active - Without Enrollment"]
        S2_0["S2.0 Active"]
        S2_2["S2.2 Active - Under LOA"]
        S3_1["S3.1 Inactive - AWOL"]
        S4_0["S4.0 Graduated"]
        S4_1["S4.1 Exited on Good Standing"]

        S1_0 -->|enrolled / enlisted| S2_0
        S2_0 -->|LOA approved| S2_2
        S2_0 -->|did not enroll, no LOA| S3_1
        S2_2 -->|returnee approved| S1_0
        S3_1 -->|returnee approved| S1_0
        S2_0 -->|University exit| S4_1
    end

    subgraph PROGRAM["Program FSM — academic standing (per program)"]
        direction LR
        P1_0["P1.0 Eligible"]
        P1_1["P1.1 Probationary"]
        P1_2["P1.2 SNAS"]
        P1_3["P1.3 Strict Probationary (IS)"]
        P1_4["P1.4 Ineligible"]
        P2_0["P2.0 Candidate for Graduation"]
        P3_0["P3.0 Graduated"]
        P3_1["P3.1 Incomplete"]

        P1_0 -->|SNAS criteria| P1_2
        P1_2 -->|criteria not reached| P1_0
        P1_1 -->|strict probation IS| P1_3
        P1_3 -->|criteria met| P1_0
        P1_3 -->|SAP failure| P1_4
        P1_1 -->|requirements met| P1_0
        P1_0 -->|retention breached| P1_4
        P1_0 -->|graduation check passed| P2_0
        P2_0 -->|commencement + 1 week| P3_0
    end

    subgraph VALID["Combination tab — validation layer (V(S,P))"]
        direction LR
        CONFIG["Runtime configuration (S, P)"] --> MATRIX["V(S,P): Yes / No per pairing"]
        MATRIX --> RULES["Allowed: S2.0+P1.3, S3.1+P1.0, S4.0+P3.0<br/>Blocked: S1.0+P2.0, S2.0+P3.0, S2.2+P1.4<br/>Full matrix: combination_matrix_post_m3.csv"]
    end

    S2_0 --> CONFIG
    P1_0 --> CONFIG

    S1_0 -.->|initial pairing| P1_0
    S1_0 -.->|probationary offer| P1_1
    P3_0 -.->|COMBO-T001 (All Programs Graduated)| S4_0
    S4_1 -.->|COMBO-T003 (Exit Forces Incomplete)| P3_1
    P1_4 -.->|COMBO-T004 (Ineligible + Shift Pending)| S1_0
    S1_0 -.->|COMBO-T005 (Shift Approved)| S2_0
