<?xml version="1.0" ?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_Applicant_Part1_AccountToSubmission" targetNamespace="http://dlsu.edu.ph/student-journey">
  <bpmn:collaboration id="Collaboration_Applicant_Part1_AccountToSubmission">
    <bpmn:participant id="Participant_Applicant_Part1_AccountToSubmission" name="A — Part 1: Account to Submission" processRef="Applicant_Part1_AccountToSubmission"/>
  </bpmn:collaboration>
  <bpmn:process id="Applicant_Part1_AccountToSubmission" name="A — Part 1: Account to Submission" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Applicant_Part1_AccountToSubmission">
      <bpmn:lane id="Lane_applicant" name="Applicant">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_oas" name="OAS / Admissions Office">
        <bpmn:flowNodeRef>GW_Req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Next</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Account created [Applicant]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#DCFCE7</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#16A34A</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#DCFCE7"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#16A34A"/>
      </bpmn:extensionElements>
    </bpmn:startEvent>
    <bpmn:userTask id="A0" name="A0 — Draft [Applicant]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#DBEAFE</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#2563EB</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#DBEAFE"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#2563EB"/>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="A1_0" name="A1.0 — Submitted Form [Applicant]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#DBEAFE</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#2563EB</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#DBEAFE"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#2563EB"/>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Req" name="Requirements OK? [OAS]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#FEF9C3</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#CA8A04</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#FEF9C3"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#CA8A04"/>
      </bpmn:extensionElements>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="A2_0" name="A2.0 — Complete Requirements [OAS]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#D1FAE5</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#059669</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#D1FAE5"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#059669"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="A2_1" name="A2.1 — Deficiencies [OAS]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#D1FAE5</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#059669</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#D1FAE5"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#059669"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Next" name="Continue to evaluation [OAS]">
      <bpmn:extensionElements>
        <color:background-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#FEE2E2</color:background-color>
        <color:border-color xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0">#DC2626</color:border-color>
        <bioc:fill xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#FEE2E2"/>
        <bioc:stroke xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" color="#DC2626"/>
      </bpmn:extensionElements>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="A0" name="Account created"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="A0" targetRef="A1_0" name="Application submitted"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="A1_0" targetRef="GW_Req"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="GW_Req" targetRef="A2_0" name="Complete"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="GW_Req" targetRef="A2_1" name="Deficiencies"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="A2_1" targetRef="A2_0" name="Requirements completed"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="A2_0" targetRef="A2_1" name="OAS requires resubmit"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="A2_0" targetRef="End_Next" name="Proceed"/>
  </bpmn:process>
